[Unit]
Description=PDF to Markdown Converter Flask App
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/WebApps/Tools/Pdf2Markdown/webapp
Environment="PATH=/home/pi/.local/bin:/home/pi/WebApps/Tools/Pdf2Markdown/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/pi/WebApps/Tools/Pdf2Markdown/.venv/bin/python3 app.py
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=append:/home/pi/WebApps/Tools/Pdf2Markdown/webapp/logs/app.log
StandardError=append:/home/pi/WebApps/Tools/Pdf2Markdown/webapp/logs/error.log

[Install]
WantedBy=multi-user.target
